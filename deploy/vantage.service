[Unit]
Description=Vantage video platform (zero-dependency node:sqlite)
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/vantage
ExecStart=/usr/local/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=80
Environment=VANTAGE_DATA=/home/azureuser/vantage/data
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
